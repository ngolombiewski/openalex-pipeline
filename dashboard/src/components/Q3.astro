---
import { Q3_COHORT, Q3_WINDOW, selectQ3, type Snapshot } from "../data/snapshot.ts";
import { count, gini, percent, stored } from "../format.ts";
import { GROUP_COLORS } from "../sections/groups.ts";
import { q3Facts, q3Points } from "../sections/q3.ts";

interface Props {
  snapshot: Snapshot;
}

const { snapshot } = Astro.props;
const view = selectQ3(snapshot);
const { points, omitted } = q3Points(view);
const { subfields, ai, cvPr, graphics } = q3Facts(snapshot);
const firstYear = Q3_COHORT + 1;
const lastYear = Q3_COHORT + Q3_WINDOW;
const ratio = (value: number | null) => (value === null ? "undefined" : stored(value));
---

<section class="finding" id="concentration" aria-labelledby="concentration-heading">
  <div class="column">
    <p class="eyebrow">3 · Citation reach and concentration</p>
    <h2 id="concentration-heading">Broad citation reach can coexist with concentrated rewards</h2>
    <p>Follow the computer-science papers published in {Q3_COHORT} through their citations in {firstYear}–{lastYear}. Two questions separate the subfields: how many papers received no citations in that window, and, among those that were, how unequally the citations were shared.</p>
    <p><span class="swatch" style={`color:${GROUP_COLORS.ai}`}>AI</span> and <span class="swatch" style={`color:${GROUP_COLORS.cv_pr}`}>Computer Vision &amp; PR</span> combine relatively broad reach with high concentration. A smaller share of their papers went uncited than in most subfields — {percent(ai.zero_share)} for AI and {percent(cvPr.zero_share)} for CV/PR — yet among cited papers their citations are among the most concentrated of the {subfields} subfields, with Ginis of {gini(ai.gini_cited_only!)} and {gini(cvPr.gini_cited_only!)}. Computer Graphics &amp; CAD has a similar Gini among cited papers ({gini(graphics.gini_cited_only!)}) but leaves far more papers uncited ({percent(graphics.zero_share)}).</p>
  </div>

  <figure class="chart wide" aria-labelledby="q3-caption">
    <div class="chart-canvas" id="q3-chart" role="img" aria-label={`Scatter plot of ${points.length} computer-science subfields for the ${Q3_COHORT} cohort. AI: ${percent(ai.zero_share)} uncited, cited-only Gini ${gini(ai.gini_cited_only!)}. Computer Vision and PR: ${percent(cvPr.zero_share)}, ${gini(cvPr.gini_cited_only!)}. Computer Graphics and CAD: ${percent(graphics.zero_share)}, ${gini(graphics.gini_cited_only!)}.`}>
      <noscript><p>The chart needs JavaScript. Every plotted value is in the table below.</p></noscript>
    </div>
    <figcaption id="q3-caption">One point per classified computer-science subfield, papers published in {Q3_COHORT}, citations received {firstYear}–{lastYear}. Horizontal: share of papers with no citations in that window. Vertical: Gini coefficient of citations among papers cited at least once; it rises toward 1 as citations become more unequal. AI is a square, CV/PR a triangle. {omitted > 0 ? `${omitted} subfield${omitted === 1 ? " has" : "s have"} no cited papers, so an undefined Gini, and ${omitted === 1 ? "is" : "are"} not plotted.` : `All ${subfields} subfields are plotted.`}</figcaption>
  </figure>

  <div class="column">
    <p class="qualification"><strong>Reading the window.</strong> Citations in the publication year itself are excluded. “Uncited” means no citations during calendar years {firstYear}–{lastYear}, not never cited. These are the same five calendar years for every paper, not each paper's first five years, and citations for {lastYear} may still be arriving. This compares subfields; it is not a pooled comparison of AI with the rest of computer science.</p>

    <details>
      <summary>Exact values, {Q3_COHORT} cohort, citations {firstYear}–{lastYear}</summary>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Citation concentration exact values">
        <table>
          <caption>Ratios at stored precision. The all-paper Gini counts uncited papers as zeros, so it also reflects the uncited share. Top 10% share: the citations received by the most-cited tenth of all papers in the cohort, uncited papers included, as a share of all citations; top 1% and 5% likewise. A ratio is undefined when the subfield received no citations in the window.</caption>
          <thead>
            <tr>
              <th scope="col">Subfield</th>
              <th scope="col">Papers</th>
              <th scope="col">Citations</th>
              <th scope="col">Uncited share</th>
              <th scope="col">Gini, all papers</th>
              <th scope="col">Gini, cited papers</th>
              <th scope="col">Top 1% share</th>
              <th scope="col">Top 5% share</th>
              <th scope="col">Top 10% share</th>
            </tr>
          </thead>
          <tbody>
            {
              view.map((r) => (
                <tr>
                  <th scope="row">{r.subfield_display_name}</th>
                  <td>{count(r.n_papers)}</td>
                  <td>{count(r.total_citations)}</td>
                  <td>{stored(r.zero_share)}</td>
                  <td>{ratio(r.gini)}</td>
                  <td>{ratio(r.gini_cited_only)}</td>
                  <td>{ratio(r.top1_share)}</td>
                  <td>{ratio(r.top5_share)}</td>
                  <td>{ratio(r.top10_share)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </details>
  </div>

  <script type="application/json" id="q3-data" set:html={JSON.stringify(points)} />
</section>

<script>
  import { mountQ3 } from "../charts/q3-chart.ts";
  import type { Q3Point } from "../sections/q3.ts";

  const data = document.getElementById("q3-data");
  const container = document.getElementById("q3-chart");
  if (data && container) mountQ3(container, JSON.parse(data.textContent ?? "[]") as Q3Point[]);
</script>
